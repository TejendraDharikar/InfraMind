// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id        String   @id @default(cuid())
  name      String
  hostName  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  metrics Metric[]
  alerts  Alert[]
}

model Metric {
  id             String   @id @default(cuid())
  serverId       String
  server         Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp      DateTime @default(now())
  cpuUsage       Float
  memoryUsage    Float
  networkUsage   Float
  diskUsage      Float
  
  @@index([serverId])
  @@index([timestamp])
}

model Alert {
  id        String    @id @default(cuid())
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type      String
  message   String
  severity  String
  status    String
  createdAt DateTime  @default(now())
  resolvedAt DateTime?
  
  @@index([serverId])
  @@index([createdAt])
}
