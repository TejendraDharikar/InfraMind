{
  "name": "inframind",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered DevOps Dashboard — Monorepo",
  "workspaces": [
    "apps/inframind-frontend",
    "apps/inframind-backend"
  ],
  "scripts": {
    "dev:frontend": "yarn nx run inframind-frontend:dev",
    "dev:backend": "yarn nx run inframind-backend:dev",
    "build:all": "yarn nx run-many -t build",
    "lint:all": "yarn nx run-many -t lint",
    "db:push": "yarn workspace inframind-backend prisma db push",
    "db:generate": "yarn workspace inframind-backend prisma generate",
    "db:seed": "yarn workspace inframind-backend run seed",
    "db:studio": "yarn workspace inframind-backend prisma studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "husky": "^9",
    "nx": "^20"
  },
  "dependencies": {
    "yarn": "^1.22.22"
  }
}
